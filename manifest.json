{
  "manifest_version": 3,
  "name": "Paws - Destress with Cute Animals",
  "version": "1.0",
  "description": "A simple app that shows random cute animal photos from Pexels to destress.",
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.pexels.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
},
  "web_accessible_resources": [{
    "resources": [
      "fontawesome-free-7.1.0-web/webfonts/*",
      "icons/*"
    ],
    "matches": ["<all_urls>"]
  }]
}
